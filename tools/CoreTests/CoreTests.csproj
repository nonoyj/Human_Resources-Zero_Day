<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the real Unity core sources (no copy) so the test cannot drift from the game code. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>HRZeroDay.Tests</RootNamespace>
    <AssemblyName>HRZeroDay.CoreTests</AssemblyName>
    <NoWarn>CS0168;CS0219;CS8632</NoWarn>
    
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ManifestBridgeTests.cs" />
    <Compile Include="DaylightTests.cs" />
    <Compile Include="SweepTests.cs" />
    <Compile Include="SweepScriptTests.cs" />
    <Compile Include="PageTransformTests.cs" />
    <Compile Include="HotspotReachTests.cs" />
    <Compile Include="InteractionTests.cs" />
    <Compile Include="SaveResumeTests.cs" />
    <Compile Include="../../unity/Assets/Scripts/Core/**/*.cs" />
    <!-- The interaction layer is pure C#: the headless runner compiles the same files Unity uses. -->
    <Compile Include="../../unity/Assets/Scripts/Game/Interaction/EvidenceMap.cs" />
    <Compile Include="../../unity/Assets/Scripts/Game/Interaction/EvidenceLedger.cs" />
    <Compile Include="../../unity/Assets/Scripts/Game/Interaction/HotspotHitTest.cs" />
    <Compile Include="../../unity/Assets/Scripts/Game/Interaction/ToolBudget.cs" />
    <Compile Include="../../unity/Assets/Scripts/Game/Interaction/DeskSession.cs" />
    <Compile Include="../../unity/Assets/Scripts/Tests/GeneratorInvariantTests.cs" />
    <!-- MonitorScreen lives in the Game assembly (it needs Color32 + the json layout), so the test
         project compiles it directly. UnityStubs supplies the tiny Unity surface it uses. -->
    <Compile Include="../../unity/Assets/Scripts/Game/Desk/MonitorScreen.cs" />
    <Compile Include="../../unity/Assets/Scripts/Game/Desk/MonitorScreenRaster.cs" />
    <Compile Include="../../unity/Assets/Scripts/Game/Desk/LetterView.cs" />
    <Compile Include="../../unity/Assets/Scripts/Game/Interaction/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Game/Applicant/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Game/Desk/MonitorScreenView.cs" />
    <Compile Include="../../unity/Assets/Scripts/Game/Layout/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Game/Desk/DeskSceneBuilder.cs" />
    <Compile Include="../../unity/Assets/Scripts/Game/Desk/RoomLighting.cs" />
    <Compile Include="../../unity/Assets/Scripts/Game/Desk/DeskLightDriver.cs" />
    <Compile Include="../UnityStubs/UnityStubs.cs" />
    <!-- Package stubs live in their own file, included here and ONLY here: Unity never compiles
         anything under tools/, so the engine stubs stay package-free (ASSEMBLY-RULES.md). -->
    <Compile Include="../UnityStubs/InputSystemStubs.cs" />
    <Compile Include="GameDataTests.cs" />
    <Compile Include="MonitorScreenTests.cs" />
    <Compile Include="MonitorScreenRasterTests.cs" />
    <Compile Include="LetterViewTests.cs" />
    <Compile Include="ScreenMetricsTests.cs" />
    <Compile Include="PaperworkTests.cs" />
  </ItemGroup>

</Project>
