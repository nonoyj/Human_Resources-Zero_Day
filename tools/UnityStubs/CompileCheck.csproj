<Project Sdk="Microsoft.NET.Sdk">
  <!-- Type-checks the Unity-facing scripts (Game + Editor) against stubs. No Unity required. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>HRZeroDay.CompileCheck</AssemblyName>
    <!-- CS0414 (field assigned but never used) is a WARNING IN THE PLAYER'S EDITOR, so it must be a
         warning here too: v119 shipped a MenuView with an unused `_hoverDirty` that Unity flagged on the
         same screen as the compile error. Silencing a warning the editor shows makes the gate lie about a
         clean build. CS0649 (JSON fields never assigned) is genuinely expected for deserialised content and
         stays off. -->
    <NoWarn>CS0168;CS0219;CS8632;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UnityStubs.cs" />
    <!-- Package stubs (Unity.InputSystem) are compiled HERE and only here. Unity never builds this
         project, so the engine stub file stays free of package namespaces (ASSEMBLY-RULES.md). -->
    <Compile Include="InputSystemStubs.cs" />
    <Compile Include="../../unity/Assets/Scripts/Core/**/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Game/**/*.cs" />
    <Compile Include="../../unity/Assets/Scripts/Editor/**/*.cs" />
  </ItemGroup>
</Project>
